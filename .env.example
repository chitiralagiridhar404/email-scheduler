PORT=3000
REDIS_URL=redis://127.0.0.1:6379
# Worker concurrency (parallel sends)
WORKER_CONCURRENCY=5
# Max emails sent per window (rate limit across all workers). 0 = disabled
RATE_LIMIT_MAX=0
RATE_LIMIT_WINDOW_MS=3600000
# Delay between sends in ms (applied by limiter when RATE_LIMIT_MAX is set)
MAX_RETRIES=3
