{
  "name": "email-scheduler",
  "version": "1.0.0",
  "description": "Persistent email job scheduler using BullMQ + Redis + Ethereal SMTP, with a dashboard",
  "main": "dist/server.js",
  "scripts": {
    "redis": "node_modules\\.cache\\redis-memory-server\\redis-binaries\\stable\\memurai.exe --port 6380 --dir redis-data --appendonly yes",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test:e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.16",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/smtp-server": "^3.5.13",
    "redis-memory-server": "^0.17.1",
    "smtp-server": "^3.21.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
